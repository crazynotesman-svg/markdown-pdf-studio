---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarkdownPdfTool from '../components/MarkdownPdfTool.astro';
import { SITE } from '../site.config';

const keywords = [
  'Markdown 转 PDF',
  '在线 Markdown 编辑器',
  'PDF 导出工具',
  '极简写作工具',
  '纯前端隐私保护',
];

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.title,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  url: SITE.url,
  description: SITE.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    ratingCount: '1',
  },
};
---

<BaseLayout
  title="Markdown 转 PDF 在线工具"
  description={SITE.description}
  keywords={keywords}
  type="website"
>
  <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />

  <section class="hero">
    <h1>极简 Markdown 转 PDF 工具</h1>
    <p>
      左侧书写 Markdown，右侧实时预览 A4 打印样式，一键导出 PDF。
      纯前端运行，内容不上传，安全又隐私。
    </p>
    <div class="tag-row">
      {keywords.map((k) => <span class="tag">{k}</span>)}
    </div>
  </section>

  <MarkdownPdfTool />
</BaseLayout>
