---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function fmt(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<BaseLayout
  title="Blog"
  description="MD→PDF Studio blog: practical notes and tutorials on Markdown, PDF, static sites, and Cloudflare deployment."
  keywords={['Markdown tutorial', 'PDF tools', 'Cloudflare Pages', 'Static sites', 'Tech blog SEO']}
  type="website"
>
  <div class="container">
    <div class="blog-head">
      <h1 data-i18n="blog.title">Blog</h1>
      <p data-i18n="blog.subtitle">Practical notes on Markdown, PDF, static sites, and edge deployment.</p>
    </div>

    <div class="post-grid">
      {
        posts.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}/`}>
            <h2>{post.data.title}</h2>
            <p class="excerpt">{post.data.description}</p>
            <div class="meta">
              <span><span data-i18n="blog.published">Published</span> {fmt(post.data.pubDate)}</span>
              {post.data.keywords.slice(0, 3).map((k) => (
                <span class="kw">{k}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
