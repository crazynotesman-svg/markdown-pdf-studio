---
import { SITE } from '../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
  // 多语言博客：当前页面语言（影响 <html lang> 与 og:locale）
  htmlLang?: string;
  // hreflang 交替链接（每个语言一条；x-default 由 DEFAULT_LANG 自动生成）
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description = SITE.description,
  keywords = [],
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = SITE.author,
  noindex = false,
  htmlLang = SITE.locale,
  alternates = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · Minimal Markdown to PDF tool`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = image ? new URL(image, SITE.url).href : new URL('/og-default.svg', SITE.url).href;

// lang 代码 → Open Graph locale（如 en → en_US）
const OG_LOCALE: Record<string, string> = {
  en: 'en_US',
  es: 'es_ES',
  'zh-CN': 'zh_CN',
  'zh-TW': 'zh_TW',
  pt: 'pt_BR',
  fr: 'fr_FR',
  de: 'de_DE',
  ja: 'ja_JP',
  ru: 'ru_RU',
  ko: 'ko_KR',
};
const ogLocale = OG_LOCALE[htmlLang] ?? htmlLang;
const xDefaultHref = alternates.find((a) => a.lang === 'en')?.href ?? canonical;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
};

if (type === 'article') {
  jsonLd['@type'] = 'BlogPosting';
  jsonLd['headline'] = title;
  jsonLd['description'] = description;
  jsonLd['datePublished'] = publishedTime?.toISOString();
  jsonLd['dateModified'] = (modifiedTime ?? publishedTime)?.toISOString();
  jsonLd['author'] = { '@type': 'Person', name: author };
  jsonLd['keywords'] = keywords.join(', ');
  jsonLd['inLanguage'] = htmlLang;
  jsonLd['mainEntityOfPage'] = canonical;
  if (image) jsonLd['image'] = ogImage;
}
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <!-- hreflang 多语言交替链接 -->
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

    <meta name="theme-color" content="#2f6df6" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script>
      import '../scripts/i18n.ts';
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
