---
// 注意：示例 Markdown 文案来自 src/i18n/translations.ts 的 tool.sample（按语言切换）
---

<div class="tool" id="tool">
  <div class="tool-toolbar">
    <div class="tb-group">
      <button class="btn" data-act="sample" type="button" data-i18n="tool.loadSample">Load sample</button>
      <button class="btn" data-act="clear" type="button" data-i18n="tool.clear">Clear</button>
    </div>
    <div class="tb-group">
      <button class="btn" data-md="bold" type="button" data-i18n-attr="title:tool.bold" title="Bold">B</button>
      <button class="btn" data-md="italic" type="button" data-i18n-attr="title:tool.italic" title="Italic"><i>I</i></button>
      <button class="btn" data-md="h2" type="button" data-i18n-attr="title:tool.heading" title="Heading">H</button>
      <button class="btn" data-md="list" type="button" data-i18n-attr="title:tool.list" title="List">≡</button>
      <button class="btn" data-md="link" type="button" data-i18n-attr="title:tool.link" title="Link">🔗</button>
      <button class="btn" data-md="code" type="button" data-i18n-attr="title:tool.code" title="Code">{'</>'}</button>
    </div>
    <div class="tb-group tb-right">
      <button class="btn" data-act="print" type="button"><span class="ico">🖨</span> <span data-i18n="tool.print">Print / Save as PDF</span></button>
      <button class="btn btn-primary" data-act="download" type="button" id="download-btn"><span class="ico">⬇</span> <span data-i18n="tool.download">Download PDF</span></button>
    </div>
  </div>

  <div class="tool-split">
    <section class="pane editor-pane">
      <div class="pane-label" data-i18n="tool.inputLabel">Markdown input</div>
      <textarea id="md-input" spellcheck="false" data-i18n-attr="aria-label:tool.inputLabel;placeholder:tool.inputPlaceholder" aria-label="Markdown input" placeholder="Write your Markdown here…"></textarea>
    </section>
    <section class="pane preview-pane">
      <div class="pane-label" data-i18n="tool.previewLabel">PDF preview (A4)</div>
      <div class="page-scroll">
        <article id="pdf-page" class="pdf-page prose"></article>
      </div>
    </section>
  </div>
</div>

<style is:global>
  .tool {
    max-width: 1280px;
    margin: 18px auto 0;
    padding: 0 16px;
  }
  .tool-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 12px 12px 0 0;
    border-bottom: none;
  }
  .tb-group {
    display: flex;
    gap: 6px;
  }
  .tb-right {
    margin-left: auto;
  }
  .tool-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
    overflow: hidden;
    min-height: 70vh;
  }
  .pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .editor-pane {
    border-right: 1px solid var(--border);
  }
  .pane-label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-soft);
    padding: 8px 14px;
    background: #fff;
    border-bottom: 1px solid var(--border);
  }
  #md-input {
    flex: 1;
    width: 100%;
    border: none;
    outline: none;
    resize: none;
    padding: 18px 20px;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.7;
    color: var(--text);
    background: #fff;
    tab-size: 2;
  }
  .preview-pane {
    background: var(--bg-page);
  }
  .page-scroll {
    flex: 1;
    overflow: auto;
    padding: 24px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .pdf-page {
    width: 794px;
    min-height: 1123px;
    background: #fff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    padding: 56px 64px;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .tool-split {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .editor-pane {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
    #md-input {
      min-height: 240px;
    }
    .pdf-page {
      width: 100%;
      min-height: auto;
      padding: 32px;
    }
    .tb-right {
      margin-left: 0;
      width: 100%;
    }
  }

  /* ---------- 打印：仅输出 PDF 页面 ---------- */
  @media print {
    .site-header,
    .site-footer,
    .hero,
    .tag-row,
    .tool-toolbar,
    .editor-pane,
    .pane-label,
    .back-link,
    .lang-select {
      display: none !important;
    }
    body {
      background: #fff;
    }
    .tool,
    .tool-split,
    .preview-pane,
    .page-scroll {
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      background: #fff !important;
      overflow: visible !important;
      max-width: none !important;
    }
    .pdf-page {
      width: auto !important;
      min-height: auto !important;
      box-shadow: none !important;
      padding: 0 !important;
      border-radius: 0 !important;
    }
    @page {
      size: A4;
      margin: 16mm;
    }
  }
</style>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';
  import { t, getLang, translations, type LangCode } from '../i18n/translations';

  const input = document.getElementById('md-input') as HTMLTextAreaElement;
  const page = document.getElementById('pdf-page') as HTMLElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;

  marked.setOptions({ gfm: true, breaks: true });

  let loadedSampleLang: LangCode = getLang();

  function currentSample(): string {
    return t('tool.sample');
  }

  function render() {
    const raw = marked.parse(input.value || '');
    page.innerHTML = DOMPurify.sanitize(raw as string);
  }

  function surround(before: string, after: string, placeholder: string) {
    const start = input.selectionStart;
    const end = input.selectionEnd;
    const selected = input.value.slice(start, end) || placeholder;
    const text = before + selected + after;
    input.setRangeText(text, start, end, 'end');
    input.focus();
    render();
  }

  function insertAtCursor(text: string) {
    const start = input.selectionStart;
    input.setRangeText(text, start, input.selectionEnd, 'end');
    input.focus();
    render();
  }

  function downloadPdf() {
    return import('https://esm.sh/html2pdf.js@0.10.2').then((mod) => {
      const html2pdf = mod.default;
      return html2pdf()
        .set({
          margin: 10,
          filename: 'markdown.pdf',
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
          pagebreak: { mode: ['css', 'legacy'] },
        })
        .from(page)
        .save();
    });
  }

  // 工具栏事件
  document.getElementById('tool')?.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('button') as HTMLButtonElement | null;
    if (!el) return;
    const act = el.dataset.act;
    const md = el.dataset.md;

    if (act === 'sample') {
      input.value = currentSample();
      loadedSampleLang = getLang();
      render();
    } else if (act === 'clear') {
      input.value = '';
      render();
    } else if (act === 'print') {
      window.print();
    } else if (act === 'download') {
      el.disabled = true;
      const label = el.querySelector('[data-i18n]') as HTMLElement;
      const old = label.textContent;
      label.textContent = t('tool.generating');
      downloadPdf()
        .catch((err) => {
          alert(t('tool.downloadError').replace('{msg}', err?.message || String(err)));
        })
        .finally(() => {
          el.disabled = false;
          label.textContent = old;
        });
    } else if (md === 'bold') {
      surround('**', '**', t('tool.bold'));
    } else if (md === 'italic') {
      surround('*', '*', t('tool.italic'));
    } else if (md === 'code') {
      surround('`', '`', t('tool.code'));
    } else if (md === 'link') {
      surround('[', '](https://)', t('tool.link'));
    } else if (md === 'h2') {
      insertAtCursor('\n## ' + t('tool.heading') + '\n');
    } else if (md === 'list') {
      insertAtCursor('\n- ' + t('tool.list') + '\n');
    }
  });

  input.addEventListener('input', render);

  // 初始内容
  input.value = currentSample();
  loadedSampleLang = getLang();
  render();

  // 切换语言时：若编辑器内容仍是“某语言示例”，则同步为新语言示例；否则保留用户内容
  document.addEventListener('langchange', (e: CustomEvent<{ lang: LangCode }>) => {
    const lang = e.detail.lang;
    const prevSample = translations[loadedSampleLang]?.['tool.sample'];
    if (prevSample != null && input.value === prevSample) {
      input.value = t('tool.sample', lang);
      render();
    }
    loadedSampleLang = lang;
  });
</script>
